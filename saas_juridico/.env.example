# Copie este arquivo para .env e preencha a chave real.
# Nunca envie .env para repositório público.

OPENAI_API_KEY=

# Modelo recomendado para piloto com bom equilíbrio de custo/qualidade.
# Para máxima qualidade em produção, ajuste conforme sua conta e política comercial.
OPENAI_MODEL=gpt-5.4-mini

# Endpoint padrão da OpenAI Responses API.
OPENAI_API_BASE=https://api.openai.com/v1

# true = tenta OpenAI quando houver chave; false = força motor local.
LEXFLOW_USE_OPENAI=true

OPENAI_TIMEOUT_SECONDS=45

# Desenvolvimento local sem Docker usa SQLite automaticamente quando DATABASE_URL fica vazio.
# Em Docker/produção, use PostgreSQL:
DATABASE_URL=postgresql://lexflow:lexflow@db:5432/lexflow

# Host 0.0.0.0 é necessário dentro do container.
APP_HOST=0.0.0.0
APP_PORT=8765

# Integracoes judiciais
# DATAJUD_API_KEY pode ficar vazio para usar a chave publica documentada pelo CNJ.
# Caso o CNJ substitua a chave publica, preencha aqui a nova chave, com ou sem o prefixo "APIKey ".
TRIBUNAL_SYNC_MODE=homolog
DATAJUD_API_KEY=

# DataJud/CNJ por Tribunal de Justica. O backend cria automaticamente conectores
# DATAJUD e DJEN para TJAC, TJAL, TJAP, TJAM, TJBA, TJCE, TJDFT, TJES, TJGO,
# TJMA, TJMT, TJMS, TJMG, TJPA, TJPB, TJPR, TJPE, TJPI, TJRJ, TJRN, TJRS,
# TJRO, TJRR, TJSC, TJSE, TJSP e TJTO.
# Para sobrescrever um tribunal especifico, use o padrao:
# TJSP_DATAJUD_ENABLED=true
# TJSP_DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
# TJSP_DATAJUD_RESOURCE_PATH=/api_publica_tjsp/_search
# TJSP_DATAJUD_AUTH_TYPE=api-key
# TJSP_DATAJUD_API_KEY_HEADER=Authorization
# TJSP_DATAJUD_API_KEY=
# TJSP_DATAJUD_REQUEST_BODY_TEMPLATE={"query":{"match":{"numeroProcesso":"{case_number_digits}"}},"size":1}
# TJSP_DATAJUD_PARSER=datajud

# PJE TJMG (DJEN/CNJ)
TJMG_PJE_ENABLED=true
TJMG_PJE_BASE_URL=https://hcomunicaapi.cnj.jus.br/api/v1
TJMG_PJE_RESOURCE_PATH=/caderno/TJMG/{date}/D
TJMG_PJE_QUERY_TEMPLATE=
TJMG_PJE_AUTH_TYPE=none
TJMG_PJE_TOKEN=
TJMG_PJE_TIMEOUT_SECONDS=25
TJMG_PJE_POLL_DAYS_BACK=2
TJMG_PJE_VERIFY_SSL=true

# EPROC TJMG
TJMG_EPROC_ENABLED=false
TJMG_EPROC_BASE_URL=
TJMG_EPROC_RESOURCE_PATH=/api/publicacoes
TJMG_EPROC_QUERY_TEMPLATE=numeroProcesso={case_number}
TJMG_EPROC_AUTH_TYPE=bearer
TJMG_EPROC_TOKEN=
TJMG_EPROC_USERNAME=
TJMG_EPROC_PASSWORD=
TJMG_EPROC_API_KEY_HEADER=
TJMG_EPROC_API_KEY=
TJMG_EPROC_TIMEOUT_SECONDS=25
TJMG_EPROC_POLL_DAYS_BACK=2
TJMG_EPROC_VERIFY_SSL=true

# JPE TJMG
TJMG_JPE_ENABLED=false
TJMG_JPE_BASE_URL=
TJMG_JPE_RESOURCE_PATH=/api/publicacoes
TJMG_JPE_QUERY_TEMPLATE=numeroProcesso={case_number}
TJMG_JPE_AUTH_TYPE=bearer
TJMG_JPE_TOKEN=
TJMG_JPE_USERNAME=
TJMG_JPE_PASSWORD=
TJMG_JPE_API_KEY_HEADER=
TJMG_JPE_API_KEY=
TJMG_JPE_TIMEOUT_SECONDS=25
TJMG_JPE_POLL_DAYS_BACK=2
TJMG_JPE_VERIFY_SSL=true
