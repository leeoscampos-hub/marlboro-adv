# Copie para .env.ec2 na instância EC2 e preencha valores reais.
# Nunca versione .env.ec2.

# Domínio apontando para o Elastic IP da EC2.
# Exemplo: APP_DOMAIN=app.seudominio.com
# Para teste sem domínio/HTTPS automático, use APP_DOMAIN=:80
APP_DOMAIN=
ACME_EMAIL=

# Aplicação
APP_HOST=0.0.0.0
APP_PORT=8765
LEXFLOW_USE_OPENAI=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=45

# Criptografia de campos sensíveis no banco.
# Gere com: openssl rand -base64 32
ENCRYPTION_PASSPHRASE=

# PostgreSQL interno do Docker Compose.
POSTGRES_DB=lexflow
POSTGRES_USER=lexflow
POSTGRES_PASSWORD=troque_por_uma_senha_longa_e_unica

# Integrações judiciais
TRIBUNAL_SYNC_MODE=homolog
DATAJUD_API_KEY=
TRIBUNAL_LAWYER_NAME=
TRIBUNAL_OAB_NUMBER=
TRIBUNAL_OAB_STATE=
TRIBUNAL_TOTP_SEED=

# Meta / omnichannel
# Os tokens de WhatsApp, Instagram e Facebook são configurados pela interface.
# Para webhooks públicos, use URLs HTTPS geradas pelo domínio:
# https://APP_DOMAIN/webhooks/meta/1/whatsapp
# https://APP_DOMAIN/webhooks/meta/1/instagram
# https://APP_DOMAIN/webhooks/meta/1/facebook

# TJMG PJe / DJEN
TJMG_PJE_ENABLED=true
TJMG_PJE_BASE_URL=https://hcomunicaapi.cnj.jus.br/api/v1
TJMG_PJE_RESOURCE_PATH=/caderno/TJMG/{date}/D
TJMG_PJE_QUERY_TEMPLATE=
TJMG_PJE_AUTH_TYPE=none
TJMG_PJE_TOKEN=
TJMG_PJE_TIMEOUT_SECONDS=25
TJMG_PJE_POLL_DAYS_BACK=2
TJMG_PJE_VERIFY_SSL=true
